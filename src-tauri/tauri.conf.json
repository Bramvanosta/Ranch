{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ranch",
  "mainBinaryName": "ranch",
  "version": "0.1.0",
  "identifier": "dev.ranch.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGQTcyQkRGOTJGQzdGMjMKUldRamYveVMzeXVuWDFGaWM3cklTV0JXa3k0NnpkaS9vL1NSd014OWJnam0wY2JYN0hwVVREMnoK",
      "endpoints": [
        "https://github.com/Bramvanosta/ranch/releases/download/update-feed/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["ranch"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ranch",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "center": true,
        "shadow": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "tabbingIdentifier": "ranch"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
